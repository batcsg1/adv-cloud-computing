[Unit]
Description=Prometheus Alertmanager
Documentation=https://prometheus.io/docs/alerting/latest/alertmanager/
After=network.target

[Service]
User=<%= scope['alertmanager::user'] %>
ExecStart=<%= scope['alertmanager::install_dir'] %>/alertmanager \
  --config.file=<%= scope['alertmanager::config_dir'] %>/alertmanager.yml \
  --storage.path=<%= scope['alertmanager::data_dir'] %>
Restart=on-failure

[Install]
WantedBy=multi-user.target
